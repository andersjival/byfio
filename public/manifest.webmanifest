      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Panel Administradora",
      "short_name": "Admin Fio",
      "description": "Acceso al panel principal de gestión de By.Fio",
      "url": "/admin",
      "icons": [{ "src": "/logo-byfio-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Alisto de Pedidos (Colaboradores)",
      "short_name": "Alisto",
      "description": "App operativa para colaboradores en taller y bodega",
      "url": "/pedidos?role=alisto",
      "icons": [{ "src": "/logo-byfio-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Facturación Rápida POS",
      "short_name": "Facturación",
      "description": "Cobro y facturación en mostrador",
      "url": "/admin?tab=billing",
      "icons": [{ "src": "/logo-byfio-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Catálogo Comercial",
      "short_name": "Catálogo",
      "description": "Catálogo interactivo de productos",
